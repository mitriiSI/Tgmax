# Never send these tokens in chat and never commit the real .env file.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# Legacy optional relay token. TGK 1–3 reads чужие публичные t.me-каналы по обычной ссылке. Оставь пустым.
# Источники задаются в основном Telegram-боте: /tgk 1 https://t.me/channel_name
WEB_RELAY_BOT_TOKEN=
WEB_RELAY_POLL_SECONDS=60
# Target size for a processed public-channel media part. Bridge 2.1 raises it to the MAX-safe value when needed.
WEB_RELAY_MEDIA_TARGET_MB=19

# Make up a long random server registration code. Every approved Telegram user uses it once to create a separate profile.
PAIRING_CODE=replace-with-a-long-random-code
# Required separate administrator password for the panel (minimum 12 characters).
# It must not equal PAIRING_CODE and must not be shared with ordinary users.
PANEL_TOKEN=replace-with-a-different-long-admin-password

# Docker stores the database in this directory.
DATA_DIR=/app/data
PORT=8080

# Keep the mapping long enough to answer older messages in MAX.
MESSAGE_LINK_TTL_DAYS=30

# Only for the optional large-file mode. Obtain both values at my.telegram.org/apps.
# Keep API_HASH secret just like bot tokens.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional safeguards for large transfers. The large-file Docker profile sets 12 hours and 1 GB.
MEDIA_TRANSFER_TIMEOUT_MINUTES=120
MEDIA_DISK_RESERVE_MB=512

# Bridge Console 2.1
CONSOLE_ENABLED=true
CONSOLE_LOG_DAYS=30
CONSOLE_MAX_MEMORY_EVENTS=5000
# false = хранить длину и короткий preview; true = сохранять полный текст сообщений в журнал
CONSOLE_SHOW_MESSAGE_TEXT=false

# 127.0.0.1 = только этот компьютер; 0.0.0.0 = локальная сеть (не открывать напрямую в интернет)
BRIDGE_BIND_IP=127.0.0.1

# Bridge Console 2.1: автоматический замер скорости и ETA
NETWORK_SPEED_TEST_INTERVAL_MINUTES=360
NETWORK_SPEED_TEST_ON_START=true
